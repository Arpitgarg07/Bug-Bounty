# Application
NODE_ENV=development
APP_NAME=Bug Bounty API
PORT=4000
HOST=0.0.0.0
BASE_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000/api/v1
FRONTEND_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://bugbounty_user:StrongPassword123!@localhost:5432/bugbounty_db?schema=public
DIRECT_DATABASE_URL=postgresql://bugbounty_user:StrongPassword123!@localhost:5432/bugbounty_db?schema=public

# Prisma
PRISMA_CLIENT_ENGINE_TYPE=binary
PRISMA_LOG_LEVEL=warn
PRISMA_MIGRATION_SHADOW_DATABASE_URL=postgresql://bugbounty_user:StrongPassword123!@localhost:5432/bugbounty_shadow_db?schema=public

# JWT Access Token
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-32-chars-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_ACCESS_ISSUER=bug-bounty-api
JWT_ACCESS_AUDIENCE=bug-bounty-web

# JWT Refresh Token
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-32-chars-min
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_ISSUER=bug-bounty-api
JWT_REFRESH_AUDIENCE=bug-bounty-web

# Cookie Configuration
COOKIE_NAME_REFRESH_TOKEN=bb_refresh_token
COOKIE_DOMAIN=localhost
COOKIE_PATH=/
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_MS=2592000000

# Cloudinary
CLOUDINARY_CLOUD_NAME=bugbounty-demo
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=replace-with-cloudinary-secret
CLOUDINARY_FOLDER=bug-bounty
CLOUDINARY_SECURE=true

# Winston Logger
LOG_LEVEL=info
LOG_FORMAT=json
LOG_INCLUDE_TIMESTAMP=true
LOG_INCLUDE_REQUEST_ID=true
LOG_SERVICE_NAME=bug-bounty-api

# Rate Limiting
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=500
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=120
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=20

# Email Service
MAIL_PROVIDER=sendgrid
MAIL_FROM=no-reply@bugbounty.example
MAIL_REPLY_TO=support@bugbounty.example
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=apikey
MAIL_PASSWORD=replace-with-email-provider-password
MAIL_DEFAULT_SENDER=Bug Bounty <no-reply@bugbounty.example>

# Frontend and API URLs
WEB_APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PUBLIC_SITE_URL=https://bugbounty.example.com

# Security and Session
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
MFA_TOTP_WINDOW=1
SESSION_IDLE_TIMEOUT_DAYS=30
SESSION_ROTATION_ENABLED=true
ENABLE_MFA=true
ENABLE_AUDIT_LOGGING=true
ENABLE_RATE_LIMITING=true

# Storage and Uploads
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,text/plain
UPLOAD_PRESIGN_EXPIRY_SECONDS=300

# Monitoring and Observability
SENTRY_DSN=
REQUEST_ID_HEADER=x-request-id
TRUST_PROXY=1

# Admin Bootstrap
ADMIN_BOOTSTRAP_EMAIL=admin@bugbounty.example
ADMIN_BOOTSTRAP_PASSWORD=ReplaceWithStrongBootstrapPassword123!
ADMIN_BOOTSTRAP_NAME=Platform Admin

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Newsletter/Notification Email
NOTIFICATION_EMAIL_TO=your-email@example.com
