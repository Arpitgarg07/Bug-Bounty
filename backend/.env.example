# Copy this file to backend/.env for local development.
# Never commit backend/.env or put real credentials in this template.
# Generate JWT secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# Application identity and local server URLs.
NODE_ENV=development
APP_NAME=Bug Bounty API
PORT=4000
HOST=0.0.0.0
BASE_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000/api/v1
FRONTEND_BASE_URL=http://localhost:3000

# PostgreSQL connection strings. Use separate app and shadow databases.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public

# Prisma client and migration settings.
PRISMA_CLIENT_ENGINE_TYPE=binary
PRISMA_LOG_LEVEL=warn
PRISMA_MIGRATION_SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/SHADOW_DATABASE?schema=public

# JWT signing secrets and token claims. Each secret must be at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-new-random-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_ACCESS_ISSUER=bug-bounty-api
JWT_ACCESS_AUDIENCE=bug-bounty-web
JWT_REFRESH_SECRET=replace-with-a-new-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_ISSUER=bug-bounty-api
JWT_REFRESH_AUDIENCE=bug-bounty-web

# Refresh-token cookie settings. Use secure=true and sameSite=none behind HTTPS.
COOKIE_NAME_REFRESH_TOKEN=bb_refresh_token
COOKIE_DOMAIN=localhost
COOKIE_PATH=/
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_MS=2592000000

# Cloudinary account and upload settings. Obtain credentials from the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=bug-bounty
CLOUDINARY_SECURE=true

# Winston logging behavior.
LOG_LEVEL=info
LOG_FORMAT=json
LOG_INCLUDE_TIMESTAMP=true
LOG_INCLUDE_REQUEST_ID=true
LOG_SERVICE_NAME=bug-bounty-api

# Rate-limit windows are milliseconds; MAX values are request counts per window.
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=500
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=120
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=20

# SMTP or email-provider settings. Store the provider password or API key only in backend/.env.
MAIL_PROVIDER=smtp
MAIL_FROM=no-reply@example.com
MAIL_REPLY_TO=support@example.com
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-mail-user
MAIL_PASSWORD=your-mail-password
MAIL_DEFAULT_SENDER=Bug Bounty <no-reply@example.com>

# Public frontend, API, and site URLs.
WEB_APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PUBLIC_SITE_URL=http://localhost:3000

# Password, verification, session, MFA, audit, and rate-limit policies.
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
MFA_TOTP_WINDOW=1
SESSION_IDLE_TIMEOUT_DAYS=30
SESSION_ROTATION_ENABLED=true
ENABLE_MFA=true
ENABLE_AUDIT_LOGGING=true
ENABLE_RATE_LIMITING=true

# Upload limits and comma-separated allowed MIME types.
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,text/plain
UPLOAD_PRESIGN_EXPIRY_SECONDS=300

# Optional monitoring and request/proxy settings.
SENTRY_DSN=
REQUEST_ID_HEADER=x-request-id
TRUST_PROXY=1

# Initial administrator account. Use a unique password and change it after bootstrap.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-unique-password-at-least-12-chars
ADMIN_BOOTSTRAP_NAME=Platform Admin

# Google OAuth client credentials and callback URL from Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Address that receives newsletter or notification messages.
NOTIFICATION_EMAIL_TO=your-email@example.com
