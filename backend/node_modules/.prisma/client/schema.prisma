generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserRole {
  RESEARCHER
  COMPANY
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum CompanyStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum CompanyMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LEFT
  REMOVED
}

enum VerificationRequestPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  COMPANY_VERIFICATION
  MFA_SETUP
}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  USED
  REVOKED
  EXPIRED
}

enum ProgramVisibility {
  PUBLIC
  PRIVATE
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
  ARCHIVED
}

enum ProgramTargetType {
  DOMAIN
  SUBDOMAIN
  IP_RANGE
  URL
  MOBILE_APP
  API
  CODE_REPOSITORY
  OTHER
}

enum ReportSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportStatus {
  SUBMITTED
  TRIAGED
  NEEDS_INFO
  DUPLICATE
  INFORMATIVE
  ACCEPTED
  REJECTED
  RESOLVED
  CLOSED
}

enum ReportCommentVisibility {
  PUBLIC
  PRIVATE
  INTERNAL
}

enum RewardStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  CANCELLED
}

enum NotificationType {
  REPORT_SUBMITTED
  REPORT_UPDATED
  REPORT_STATUS_CHANGED
  REPORT_COMMENTED
  REWARD_CREATED
  REWARD_UPDATED
  REWARD_PAID
  PROGRAM_CREATED
  PROGRAM_UPDATED
  COMPANY_VERIFIED
  VERIFICATION_REQUEST_CREATED
  PASSWORD_RESET_REQUESTED
  ACCOUNT_VERIFIED
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum LeaderboardPeriod {
  WEEKLY
  MONTHLY
  ALL_TIME
}

enum AttachmentKind {
  EVIDENCE
  IMAGE
  VIDEO
  DOCUMENT
  LOG
  ARCHIVE
  OTHER
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  role            UserRole
  status          UserStatus @default(PENDING_VERIFICATION)
  name            String     @db.VarChar(120)
  email           String     @unique @db.VarChar(255)
  passwordHash    String     @db.VarChar(255)
  googleId        String?    @unique @db.VarChar(255)
  avatarUrl       String?    @db.VarChar(2048)
  bio             String?    @db.Text
  locale          String?    @db.VarChar(12)
  timezone        String?    @db.VarChar(64)
  isEmailVerified Boolean    @default(false)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  ownedCompanies       Company[]             @relation("CompanyOwner")
  verifiedCompanies    Company[]             @relation("CompanyVerifier")
  companyMemberships   CompanyMember[]
  invitedMembers       CompanyMember[]       @relation("CompanyMemberInviter")
  verificationRequests VerificationRequest[] @relation("VerificationRequestUser")
  createdPrograms      Program[]             @relation("ProgramCreator")
  submittedReports     Report[]              @relation("ReportReporter")
  assignedReports      Report[]              @relation("ReportAssignee")
  reportComments       ReportComment[]       @relation("ReportCommentAuthor")
  receivedRewards      Reward[]              @relation("RewardRecipient")
  processedRewards     Reward[]              @relation("RewardProcessor")
  notifications        Notification[]        @relation("NotificationRecipient")
  leaderboardEntries   LeaderboardEntry[]
  uploadedAttachments  Attachment[]          @relation("AttachmentUploader")

  @@index([role])
  @@index([status])
  @@index([deletedAt])
}

model Company {
  id               String        @id @default(uuid()) @db.Uuid
  ownerUserId      String        @db.Uuid
  verifiedByUserId String?       @db.Uuid
  name             String        @db.VarChar(160)
  slug             String        @unique @db.VarChar(180)
  websiteUrl       String?       @db.VarChar(2048)
  description      String?       @db.Text
  logoUrl          String?       @db.VarChar(2048)
  status           CompanyStatus @default(PENDING_VERIFICATION)
  verifiedAt       DateTime?
  verificationNote String?       @db.Text
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  ownerUser            User                  @relation("CompanyOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  verifiedByUser       User?                 @relation("CompanyVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  members              CompanyMember[]
  verificationRequests VerificationRequest[] @relation("VerificationRequestCompany")
  programs             Program[]
  rewards              Reward[]

  @@index([ownerUserId])
  @@index([status])
  @@index([deletedAt])
}

model CompanyMember {
  id              String              @id @default(uuid()) @db.Uuid
  companyId       String              @db.Uuid
  userId          String              @db.Uuid
  invitedByUserId String?             @db.Uuid
  role            CompanyMemberRole   @default(MEMBER)
  status          CompanyMemberStatus @default(INVITED)
  invitedAt       DateTime?
  joinedAt        DateTime?
  leftAt          DateTime?
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  memberUser    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  invitedByUser User?   @relation("CompanyMemberInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([companyId, userId])
  @@index([companyId, status])
  @@index([userId, status])
  @@index([deletedAt])
}

model VerificationRequest {
  id              String                     @id @default(uuid()) @db.Uuid
  targetUserId    String?                    @db.Uuid
  targetCompanyId String?                    @db.Uuid
  purpose         VerificationRequestPurpose
  status          VerificationRequestStatus  @default(PENDING)
  tokenHash       String                     @unique @db.VarChar(255)
  metadata        Json?
  requestedAt     DateTime                   @default(now())
  expiresAt       DateTime
  approvedAt      DateTime?
  rejectedAt      DateTime?
  usedAt          DateTime?
  revokedAt       DateTime?
  deletedAt       DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  targetUser    User?        @relation("VerificationRequestUser", fields: [targetUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  targetCompany Company?     @relation("VerificationRequestCompany", fields: [targetCompanyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  attachments   Attachment[]

  @@index([targetUserId, purpose])
  @@index([targetCompanyId, purpose])
  @@index([status])
  @@index([expiresAt])
  @@index([deletedAt])
}

model Program {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @db.Uuid
  createdByUserId String            @db.Uuid
  name            String            @db.VarChar(180)
  slug            String            @db.VarChar(200)
  summary         String?           @db.VarChar(255)
  description     String?           @db.Text
  visibility      ProgramVisibility @default(PRIVATE)
  status          ProgramStatus     @default(DRAFT)
  websiteUrl      String?           @db.VarChar(2048)
  policyUrl       String?           @db.VarChar(2048)
  instructions    String?           @db.Text
  scope           Json?
  currency        String            @default("USD") @db.VarChar(3)
  minBountyAmount Decimal?          @db.Decimal(12, 2)
  maxBountyAmount Decimal?          @db.Decimal(12, 2)
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdByUser User            @relation("ProgramCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  targets       ProgramTarget[]
  reports       Report[]

  @@unique([companyId, slug])
  @@index([companyId, status])
  @@index([visibility])
  @@index([deletedAt])
}

model ProgramTarget {
  id          String            @id @default(uuid()) @db.Uuid
  programId   String            @db.Uuid
  type        ProgramTargetType
  target      String            @db.VarChar(255)
  description String?           @db.Text
  isInScope   Boolean           @default(true)
  notes       String?           @db.Text
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([programId, type, target])
  @@index([programId, isInScope])
  @@index([deletedAt])
}

model Report {
  id                  String         @id @default(uuid()) @db.Uuid
  programId           String         @db.Uuid
  reporterUserId      String         @db.Uuid
  assignedToUserId    String?        @db.Uuid
  duplicateOfReportId String?        @db.Uuid
  referenceCode       String         @db.VarChar(40)
  title               String         @db.VarChar(220)
  summary             String?        @db.VarChar(255)
  description         String         @db.Text
  reproductionSteps   String?        @db.Text
  impact              String?        @db.Text
  proofOfConcept      String?        @db.Text
  severity            ReportSeverity
  status              ReportStatus   @default(SUBMITTED)
  cvssScore           Decimal?       @db.Decimal(3, 1)
  triagedAt           DateTime?
  resolvedAt          DateTime?
  closedAt            DateTime?
  deletedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  program          Program         @relation(fields: [programId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reporter         User            @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignee         User?           @relation("ReportAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  originalReport   Report?         @relation("ReportDuplicate", fields: [duplicateOfReportId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  duplicateReports Report[]        @relation("ReportDuplicate")
  comments         ReportComment[]
  attachments      Attachment[]
  reward           Reward?

  @@unique([programId, referenceCode])
  @@index([programId, status])
  @@index([reporterUserId, status])
  @@index([assignedToUserId, status])
  @@index([severity])
  @@index([deletedAt])
}

model ReportComment {
  id              String                  @id @default(uuid()) @db.Uuid
  reportId        String                  @db.Uuid
  authorUserId    String                  @db.Uuid
  parentCommentId String?                 @db.Uuid
  visibility      ReportCommentVisibility @default(PUBLIC)
  body            String                  @db.Text
  isInternal      Boolean                 @default(false)
  deletedAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  report        Report          @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author        User            @relation("ReportCommentAuthor", fields: [authorUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parentComment ReportComment?  @relation("ReportCommentThread", fields: [parentCommentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  childComments ReportComment[] @relation("ReportCommentThread")
  attachments   Attachment[]

  @@index([reportId, createdAt])
  @@index([authorUserId, createdAt])
  @@index([deletedAt])
}

model Reward {
  id                String       @id @default(uuid()) @db.Uuid
  reportId          String       @unique @db.Uuid
  companyId         String       @db.Uuid
  recipientUserId   String?      @db.Uuid
  processedByUserId String?      @db.Uuid
  amount            Decimal      @db.Decimal(12, 2)
  currency          String       @default("USD") @db.VarChar(3)
  status            RewardStatus @default(PENDING)
  approvedAt        DateTime?
  paidAt            DateTime?
  rejectedAt        DateTime?
  paymentReference  String?      @db.VarChar(255)
  notes             String?      @db.Text
  deletedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  report          Report       @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recipientUser   User?        @relation("RewardRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  processedByUser User?        @relation("RewardProcessor", fields: [processedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  attachments     Attachment[]

  @@index([companyId, status])
  @@index([recipientUserId, status])
  @@index([deletedAt])
}

model Notification {
  id              String             @id @default(uuid()) @db.Uuid
  recipientUserId String             @db.Uuid
  type            NotificationType
  status          NotificationStatus @default(UNREAD)
  title           String             @db.VarChar(180)
  message         String             @db.Text
  data            Json?
  readAt          DateTime?
  archivedAt      DateTime?
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  recipientUser User @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([recipientUserId, status, createdAt])
  @@index([type])
  @@index([deletedAt])
}

model LeaderboardEntry {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @db.Uuid
  period        LeaderboardPeriod
  periodStart   DateTime
  periodEnd     DateTime
  reportsCount  Int               @default(0)
  rewardedCount Int               @default(0)
  totalRewards  Decimal           @default(0) @db.Decimal(12, 2)
  score         Int               @default(0)
  rank          Int?
  deletedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, period, periodStart])
  @@index([period, periodStart, score])
  @@index([rank])
  @@index([deletedAt])
}

model Attachment {
  id                    String         @id @default(uuid()) @db.Uuid
  uploadedByUserId      String?        @db.Uuid
  reportId              String?        @db.Uuid
  reportCommentId       String?        @db.Uuid
  verificationRequestId String?        @db.Uuid
  rewardId              String?        @db.Uuid
  kind                  AttachmentKind @default(OTHER)
  fileName              String         @db.VarChar(255)
  originalFileName      String?        @db.VarChar(255)
  mimeType              String         @db.VarChar(120)
  sizeBytes             Int
  storageKey            String         @unique @db.VarChar(255)
  url                   String         @db.VarChar(2048)
  checksum              String?        @db.VarChar(128)
  deletedAt             DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  uploadedByUser      User?                @relation("AttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  report              Report?              @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reportComment       ReportComment?       @relation(fields: [reportCommentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  verificationRequest VerificationRequest? @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reward              Reward?              @relation(fields: [rewardId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([uploadedByUserId, createdAt])
  @@index([reportId])
  @@index([reportCommentId])
  @@index([verificationRequestId])
  @@index([rewardId])
  @@index([deletedAt])
}

model NewsletterSubscriber {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique @db.VarChar(255)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([email])
  @@index([subscribedAt])
}
